rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Aturan keamanan untuk To-Do List per-user (Tugas 2)
    // Hanya pengguna yang sudah terautentikasi (login) dan memiliki UID yang cocok
    // yang diizinkan untuk membaca dan menulis tugas miliknya sendiri.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

